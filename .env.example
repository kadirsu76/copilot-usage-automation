# ================================================================
# Microsoft Entra ID (Azure AD) - Service Principal Credentials
# Local geliştirme ve test için kullanılır.
# Azure Automation'a geçildiğinde Managed Identity otomatik devreye girer.
# ================================================================

# Entra ID Tenant ID (Directory ID)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# App Registration (Service Principal) Application (Client) ID
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# App Registration Client Secret Value
AZURE_CLIENT_SECRET=your_client_secret_here

# ================================================================
# Report & Email Settings
# ================================================================

# Veri periyodu: D7, D30, D90, D180
REPORT_PERIOD=D30

# Raporu HTML olarak kaydedeceği klasör
OUTPUT_DIR=output

# Mail gönderimi (Azure Automation veya test için)
# Gönderen Shared Mailbox / User UPN (Service Principal Mail.Send izni ile)
MAIL_SENDER=reports@yourdomain.com

# Raporun iletileceği e-posta adresleri (virgülle ayırarak birden fazla eklenebilir)
MAIL_RECIPIENTS=admin@yourdomain.com,management@yourdomain.com

# Mail başlığı
MAIL_SUBJECT=Microsoft 365 Copilot Aylık Kullanım ve Benimseme Raporu
