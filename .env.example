# ================================================================
# Microsoft Entra ID (Azure AD) - Service Principal Credentials
# Used for local CLI development and testing.
# When running in Azure Automation, Managed Identity is used automatically.
# ================================================================

# Entra ID Tenant ID (Directory ID)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# App Registration (Service Principal) Application (Client) ID
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# App Registration Client Secret Value
AZURE_CLIENT_SECRET=your_client_secret_here

# ================================================================
# Report & Email Settings
# ================================================================

# Telemetry aggregation period: D7, D28, D90, D180 (Graph v2 standard)
REPORT_PERIOD=D28

# Local report export directory
OUTPUT_DIR=output

# Sender mailbox UPN (requires Mail.Send permission on Graph API)
MAIL_SENDER=reports@yourdomain.com

# Comma-separated list of recipient email addresses
MAIL_RECIPIENTS=admin@yourdomain.com,management@yourdomain.com
